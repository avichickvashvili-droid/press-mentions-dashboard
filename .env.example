# .env.example — copy this file to .env to change settings. Never commit .env.
# Every setting is optional: without a .env file the defaults in src/config.js are used.

# Where the SQLite database file lives (relative to the project folder).
# Default: db/press-mentions.sqlite
# DB_PATH=db/press-mentions.sqlite

# How many articles the classifier sends to Ollama at the same time.
# Must match OLLAMA_NUM_PARALLEL on the Ollama server. Default: 4 (see README, LLM research section 7).
# LLM_CONCURRENCY=4

# Where the local Ollama server listens, and which model it uses.
# Defaults: http://127.0.0.1:11434 and qwen3:4b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
