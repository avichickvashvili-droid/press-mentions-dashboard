# Dependencies
node_modules/

# Environment variables and secrets (keep .env.example as a template)
.env
.env.*
!.env.example

# Build output (React + Vite)
dist/
build/
.vite/

# Local SQLite database (results are exported to data/*.json, which IS committed)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
# SQLite side files (write-ahead log, shared memory, rollback journal) of the .sqlite / .sqlite3 files
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Unfinished data/ export files (written first, then renamed over the real file)
data/*.tmp

# Test coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*

# Editor and OS files
.idea/
*.swp
.DS_Store
Thumbs.db
