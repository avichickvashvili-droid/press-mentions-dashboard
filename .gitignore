# Dependencies
node_modules/

# Environment variables and secrets (keep .env.example as a template)
.env
.env.*
!.env.example

# Build output (React + Vite)
dist/
build/
.vite/

# A copy of the Docker database for reading (GUIDE: Check things in the database)
db-docker/

# Local SQLite database (results are exported to data/*.json, which IS committed)
*.sqlite
# ...except the starting database of the Docker setup (npm run docker:snapshot, D116)
!docker/seed/press-mentions.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
# SQLite side files (write-ahead log, shared memory, rollback journal) of the .sqlite / .sqlite3 files
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# The lock file of an open `npm run daily` (src/daily/processLock.js)
daily.lock

# Unfinished data/ export files (written first, then renamed over the real file)
data/*.tmp

# Test coverage
coverage/

# Logs (the default logs folder is db/logs/, next to the database; "logs/" matches it and any
# other folder named logs)
logs/
*.log
npm-debug.log*

# Editor and OS files
.idea/
*.swp
.DS_Store
Thumbs.db
